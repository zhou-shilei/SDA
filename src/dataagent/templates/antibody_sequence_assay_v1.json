{
  "template_id": "antibody-sequence-assay-v1",
  "version": 1,
  "construct_mapping": {
    "headers": {
      "construct": ["抗体", "antibody", "construct"],
      "VH": ["vh", "重链", "heavy chain"],
      "VL": ["vl", "轻链", "light chain"]
    },
    "seq_id_value_pattern": "^(?:SEQ\\s*ID\\s*NO\\s*:?\\s*)?(\\d+)$"
  },
  "sequence_definition": {
    "label_patterns": [
      "^\\s*>\\s*(?P<family>[A-Za-z]{1,12}\\d+)\\s*(?P<chain>VH|VL)\\s*(?P<variant>\\d+)\\s*:?.*$"
    ],
    "scope_patterns": {
      "variable_heavy": ["\\bVH\\s*\\d+\\b", "重链可变区", "heavy\\s+chain\\s+variable"],
      "variable_light": ["\\bVL\\s*\\d+\\b", "轻链可变区", "light\\s+chain\\s+variable"],
      "full_heavy_chain": ["抗体重链", "antibody\\s+heavy\\s+chain"],
      "full_light_chain": ["抗体轻链", "antibody\\s+light\\s+chain"],
      "heavy_cdr": ["\\bHCDR\\s*[123]\\b"],
      "light_cdr": ["\\bLCDR\\s*[123]\\b"],
      "constant_region": ["恒定区", "constant\\s+region"]
    },
    "seq_id_pattern": "SEQ\\s*ID\\s*NO\\s*:?(?:<br>)?\\s*(\\d+)",
    "variable_length": {
      "VH": [70, 160],
      "VL": [70, 140]
    },
    "page_scan_before": 3,
    "page_scan_after": 0
  },
  "assay": {
    "entity_headers": ["抗体", "antibody", "construct"],
    "endpoints": ["IC50", "IC₅₀"],
    "default_unit": "nM",
